@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Admin Dashboard";
    var sectionTitle = controller switch
    {
        "Dashboard" => "Overview",
        "Stations" => "Gaming Stations",
        "Categories" => "Gaming Categories",
        "Reservations" => "Reservations",
        "Customers" => "Customers",
        _ => controller
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090611" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@pageTitle | Neon Nexus Admin</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/vapor/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/neon-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/neon-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Gaming_Lounge.styles.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-header">
                <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="admin-brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>
                    <span class="admin-brand-copy">
                        <strong>NEON NEXUS</strong>
                        <small>Command Center</small>
                    </span>
                </a>
                <button class="admin-sidebar-close" type="button" data-sidebar-close aria-label="Close navigation">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <partial name="_AdminNav" />

            <div class="admin-sidebar-footer">
                <span class="system-indicator"><i></i> Systems operational</span>
                <small>Admin Console v1.0</small>
            </div>
        </aside>

        <div class="admin-sidebar-overlay" data-sidebar-close></div>

        <div class="admin-workspace">
            <header class="admin-topbar">
                <div class="admin-topbar-start">
                    <button class="admin-menu-toggle" type="button" data-sidebar-toggle aria-label="Toggle navigation">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="admin-page-context">
                        <nav aria-label="Breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                                </li>
                                @if (controller != "Dashboard")
                                {
                                    <li class="breadcrumb-item active" aria-current="page">@sectionTitle</li>
                                }
                                else
                                {
                                    <li class="breadcrumb-item active" aria-current="page">Overview</li>
                                }
                            </ol>
                        </nav>
                        <h1>@pageTitle</h1>
                    </div>
                </div>

                <div class="admin-topbar-actions">
                    <a class="admin-site-link" asp-area="" asp-controller="Home" asp-action="Index" title="View customer website">
                        <i class="bi bi-globe2"></i>
                        <span>Customer site</span>
                    </a>
                    <div class="dropdown">
                        <button class="admin-account-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="admin-avatar">@((currentUser?.DisplayName ?? "A").Substring(0, 1).ToUpperInvariant())</span>
                            <span class="admin-account-copy">
                                <strong>@(currentUser?.DisplayName ?? "Administrator")</strong>
                                <small>Administrator</small>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end admin-account-menu">
                            <li class="admin-account-summary">
                                <strong>@(currentUser?.DisplayName ?? "Administrator")</strong>
                                <small>@(currentUser?.Email ?? User.Identity?.Name)</small>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-gear"></i> Account profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-box-arrow-up-right"></i> Customer website
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="dropdown-item text-danger" type="submit">
                                        <i class="bi bi-box-arrow-right"></i> Secure logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="admin-main" role="main">
                <div class="admin-alerts" aria-live="polite">
                    @if (TempData["Success"] is string success)
                    {
                        <div class="alert alert-success alert-dismissible fade show admin-alert" role="alert">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@success</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] is string error)
                    {
                        <div class="alert alert-danger alert-dismissible fade show admin-alert" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@error</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="modal fade admin-confirm-modal" id="adminConfirmModal" tabindex="-1" aria-labelledby="adminConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <span class="confirm-icon"><i class="bi bi-exclamation-triangle"></i></span>
                    <h2 id="adminConfirmTitle">Confirm action</h2>
                    <p data-confirm-message>This action may change live lounge data.</p>
                    <div class="confirm-actions">
                        <button type="button" class="btn btn-admin-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" data-confirm-accept>Continue</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>