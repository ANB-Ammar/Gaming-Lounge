@model AdminCategoryEditViewModel
@{
    ViewData["Title"] = "Edit Gaming Category";
}

<header class="admin-page-header">
    <div>
        <span class="admin-kicker"><i class="bi bi-tag"></i> Catalog architecture</span>
        <h2>Edit @Model.Name</h2>
        <p>Update how this category appears and behaves on the public website.</p>
    </div>
</header>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form-card">
    <partial name="_Form" model="Model" />
    <div class="admin-form-actions">
        <a class="btn btn-admin-secondary" asp-action="Index">Cancel</a>
        <button class="btn btn-admin-primary" type="submit">
            <i class="bi bi-check2 me-1"></i> Save category
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}