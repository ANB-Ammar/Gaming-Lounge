@model AdminCategoryEditViewModel
@{
    ViewData["Title"] = "Add Gaming Category";
}

<header class="admin-page-header">
    <div>
        <span class="admin-kicker"><i class="bi bi-tag"></i> Catalog architecture</span>
        <h2>Add a gaming category</h2>
        <p>Create a new group for organizing gaming stations on the public website.</p>
    </div>
</header>

<form asp-action="Create" method="post" class="admin-form-card">
    <partial name="_Form" model="Model" />
    <div class="admin-form-actions">
        <a class="btn btn-admin-secondary" asp-action="Index">Cancel</a>
        <button class="btn btn-admin-primary" type="submit">
            <i class="bi bi-plus-lg me-1"></i> Create category
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}