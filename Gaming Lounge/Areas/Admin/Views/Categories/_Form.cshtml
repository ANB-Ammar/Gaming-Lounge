@model AdminCategoryEditViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
<input asp-for="Id" type="hidden" />
@if (Model.Id > 0)
{
    <input asp-for="Slug" type="hidden" />
}

<section class="admin-form-section">
    <header class="admin-form-section-header">
        <h3>Category details</h3>
        <p>Set the public name, generated URL identifier, description, and display order.</p>
    </header>
    <div class="row g-3">
        <div class="col-lg-8">
            <label asp-for="Name" class="form-label"></label>
            @if (Model.Id == 0)
            {
                <input asp-for="Name" class="form-control" placeholder="e.g. Elite PC Arena"
                       data-slug-source data-slug-target="#categorySlugPreview" />
            }
            else
            {
                <input asp-for="Name" class="form-control" placeholder="e.g. Elite PC Arena" />
            }
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-lg-4">
            <label asp-for="SortOrder" class="form-label">Display order</label>
            <input asp-for="SortOrder" class="form-control" />
            <span asp-validation-for="SortOrder" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">URL slug</label>
            <div class="admin-slug-preview">
                <i class="bi bi-link-45deg"></i>
                <code id="categorySlugPreview" data-slug-fallback="category">@(string.IsNullOrWhiteSpace(Model.Slug) ? "category" : Model.Slug)</code>
            </div>
            <small class="admin-field-help">
                @(Model.Id == 0
                    ? "Generated automatically from the name. A number is added if the slug already exists."
                    : "Existing category links stay unchanged when the name is edited.")
            </small>
        </div>
        <div class="col-md-3">
            <label asp-for="IconClass" class="form-label">Bootstrap icon class</label>
            <input asp-for="IconClass" class="form-control" placeholder="bi-pc-display" />
            <span asp-validation-for="IconClass" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="AccentColor" class="form-label">Accent color</label>
            <select asp-for="AccentColor" class="form-select">
                <option value="cyan">Cyan</option>
                <option value="pink">Pink</option>
                <option value="purple">Purple</option>
            </select>
            <span asp-validation-for="AccentColor" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" rows="4" class="form-control"
                      placeholder="Explain what makes this gaming category unique."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Visible to customers</label>
            </div>
        </div>
    </div>
</section>