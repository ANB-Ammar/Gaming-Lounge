@model AdminStationEditViewModel
@{
    ViewData["Title"] = "Add Gaming Station";
}

<header class="admin-page-header">
    <div>
        <span class="admin-kicker"><i class="bi bi-plus-square"></i> Fleet deployment</span>
        <h2>Add a gaming station</h2>
        <p>Create a new reservable station using an existing gaming category.</p>
    </div>
</header>

<form asp-action="Create" method="post" class="admin-form-card">
    <partial name="_Form" model="Model" />
    <div class="admin-form-actions">
        <a class="btn btn-admin-secondary" asp-action="Index">Cancel</a>
        <button class="btn btn-admin-primary" type="submit">
            <i class="bi bi-plus-lg me-1"></i> Create station
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}