FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY ["Gaming Lounge.csproj", "./"]
RUN dotnet restore "Gaming Lounge.csproj"

COPY . .
RUN dotnet publish "Gaming Lounge.csproj" -c Release --no-restore -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

WORKDIR /app

COPY --from=build /app/publish ./

ENV ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_EnableDiagnostics=0 \
    PORT=8080

EXPOSE 8080

ENTRYPOINT ["dotnet", "Gaming Lounge.dll"]